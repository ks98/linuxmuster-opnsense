#!/usr/bin/env python3
import sys
import argparse
from linuxmusterOPNsense.LinuxmusterOPNsenseAPI import LinuxmusterOPNsenseAPI

def parse_time_to_seconds(timestr):
    """
    Converts a time argument (e.g. '4h', '1d', '24h', '0', 'never', 'none') into seconds.
    A bare number is interpreted as hours (e.g. '4' == '4h').
    Raises a ValueError if the format is invalid or the value is negative.
    """
    timestr = timestr.lower().strip()
    if timestr in ("0", "never", "none"):
        return 0
    if timestr.endswith('d'):
        try:
            seconds = int(timestr[:-1]) * 24 * 3600
        except ValueError:
            raise ValueError(f"Invalid time format: {timestr}")
    elif timestr.endswith('h'):
        try:
            seconds = int(timestr[:-1]) * 3600
        except ValueError:
            raise ValueError(f"Invalid time format: {timestr}")
    elif timestr.isdigit():
        seconds = int(timestr) * 3600
    else:
        raise ValueError(f"Unknown time format: {timestr}")

    if seconds < 0:
        raise ValueError(f"Time value must not be negative: {timestr}")
    return seconds

def main():
    parser = argparse.ArgumentParser(
        description="Manages OPNsense Captive Portal Vouchers (create, list, delete)."
    )
    parser.add_argument(
        "--school",
        default="default-school",
        help="Name of the school configuration (INI file without .ini) in /etc/linuxmuster/opnsense/"
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    # ---------------------------------------------------------
    # Subcommand: list
    list_parser = subparsers.add_parser(
        "list",
        help="Lists all voucher groups or vouchers within a group if a group name is provided."
    )
    list_parser.add_argument(
        "group",
        nargs="?",
        default=None,
        help="Name of the voucher group (optional). If omitted, all groups are listed."
    )

    # ---------------------------------------------------------
    # Subcommand: create
    create_parser = subparsers.add_parser(
        "create",
        help="Creates new vouchers in a specified group."
    )
    create_parser.add_argument("group", help="Name of the voucher group, e.g. 'test'.")
    create_parser.add_argument(
        "--validity",
        default="4h",
        help="Validity period of each voucher (e.g. '4h', '1d'). Default: 4h."
    )
    create_parser.add_argument(
        "--expiry",
        default="never",
        help="Time until a voucher expires (e.g. '24h', '2d', 'never'). Default: 'never'."
    )
    create_parser.add_argument(
        "--count",
        type=int,
        default=5,
        help="Number of vouchers to create. Default: 5."
    )

    # ---------------------------------------------------------
    # Subcommand: delete
    delete_parser = subparsers.add_parser(
        "delete",
        help="Deletes (expires/drops) one or more vouchers or entire groups."
    )
    delete_parser.add_argument("group", help="Name of the voucher group.")
    # Exactly one deletion mode must be chosen; they are mutually exclusive so
    # combining them can no longer silently ignore one of the flags.
    delete_mode = delete_parser.add_mutually_exclusive_group(required=True)
    delete_mode.add_argument(
        "--username",
        help="Expire a single voucher (which must be in GROUP) by username."
    )
    delete_mode.add_argument(
        "--all-expired",
        action="store_true",
        help="Delete all expired vouchers in this group."
    )
    delete_mode.add_argument(
        "--all",
        action="store_true",
        help="Drop the entire group (including all vouchers)."
    )

    args = parser.parse_args()

    # Initialize API
    try:
        api = LinuxmusterOPNsenseAPI(school_name=args.school)
    except Exception as e:
        print(f"Error loading school configuration '{args.school}': {e}", file=sys.stderr)
        sys.exit(1)

    # --------------------------------------------------------------------------
    # SUBCOMMAND: list
    # --------------------------------------------------------------------------
    if args.command == "list":
        if not args.group:
            # List groups
            try:
                groups = api.list_voucher_groups()
                print("Available voucher groups:")
                if isinstance(groups, list):
                    for g in groups:
                        print(f"  - {g}")
                else:
                    print(f"Unexpected format for voucher groups: {groups}")

                print("\nTo list vouchers in a specific group, run:")
                print("   opn-captive-voucher list <group>\n")

            except Exception as e:
                print(f"Error listing voucher groups: {e}", file=sys.stderr)
                sys.exit(1)
        else:
            # List vouchers in a group
            try:
                vouchers = api.list_vouchers_in_group(args.group)
                print(f"Vouchers in group '{args.group}':")
                if isinstance(vouchers, list):
                    if vouchers:
                        for v in vouchers:
                            print(
                                f"  - User: {v.get('username')}  "
                                f"State: {v.get('state')}  "
                                f"Validity: {v.get('validity')}s "
                                f"Expirytime: {v.get('expirytime')} "
                                f"Starttime: {v.get('starttime')} "
                            )
                    else:
                        print("  (No vouchers in this group.)")
                else:
                    print(f"Unexpected format for voucher list: {vouchers}")

            except Exception as e:
                print(f"Error listing vouchers in group '{args.group}': {e}", file=sys.stderr)
                sys.exit(1)

    # --------------------------------------------------------------------------
    # SUBCOMMAND: create
    # --------------------------------------------------------------------------
    elif args.command == "create":
        try:
            validity_sec = parse_time_to_seconds(args.validity)
            expiry_sec = parse_time_to_seconds(args.expiry)
            result = api.create_vouchers(
                group=args.group,
                validity_seconds=validity_sec,
                expiry_seconds=expiry_sec,
                count=args.count
            )
            # Report the number of vouchers the API actually returned, not the
            # number requested, so partial/failed responses aren't misreported.
            if isinstance(result, list):
                print(f"Successfully created {len(result)} voucher(s) in group '{args.group}':\n")
                for idx, r in enumerate(result, start=1):
                    print(f"{idx:2d}) username={r.get('username')}   password={r.get('password')}")
            else:
                print(f"Unexpected response format: {result}")
        except Exception as e:
            print(f"Error creating vouchers: {e}", file=sys.stderr)
            sys.exit(1)

    # --------------------------------------------------------------------------
    # SUBCOMMAND: delete
    # --------------------------------------------------------------------------
    elif args.command == "delete":
        if args.username:
            # expire_voucher operates provider-wide, so first confirm the voucher
            # actually belongs to the requested group. Otherwise the group
            # argument would be silently ignored and a voucher from a different
            # group could be expired.
            try:
                vouchers = api.list_vouchers_in_group(args.group)
            except Exception as e:
                print(f"Error looking up group '{args.group}': {e}", file=sys.stderr)
                sys.exit(1)

            usernames = [v.get('username') for v in vouchers] if isinstance(vouchers, list) else []
            if args.username not in usernames:
                print(
                    f"Error: voucher '{args.username}' was not found in group '{args.group}'.",
                    file=sys.stderr,
                )
                sys.exit(1)

            # Expire the single voucher
            try:
                result = api.expire_voucher(args.username)
                print(f"Voucher '{args.username}' in group '{args.group}' has been expired.")
                print(f"Response: {result}")
            except Exception as e:
                print(f"Error expiring voucher '{args.username}': {e}", file=sys.stderr)
                sys.exit(1)

        elif args.all_expired:
            # Drop all expired vouchers
            try:
                result = api.drop_expired_vouchers(args.group)
                print(f"Expired vouchers in group '{args.group}' have been deleted.")
                print(f"Response: {result}")
            except Exception as e:
                print(f"Error deleting expired vouchers in group '{args.group}': {e}", file=sys.stderr)
                sys.exit(1)

        elif args.all:
            # Drop the entire group
            try:
                result = api.drop_voucher_group(args.group)
                print(f"The entire group '{args.group}' (including all vouchers) has been dropped.")
                print(f"Response: {result}")
            except Exception as e:
                print(f"Error dropping group '{args.group}': {e}", file=sys.stderr)
                sys.exit(1)

        else:
            print("Error: Please specify either --username <USER>, --all-expired or --all.", file=sys.stderr)
            sys.exit(1)

if __name__ == "__main__":
    main()
