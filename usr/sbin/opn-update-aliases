#!/usr/bin/env python3
import sys
import argparse
from linuxmusterOPNsense.LinuxmusterOPNsenseAPI import (
    LinuxmusterOPNsenseAPI, sanitize_alias_name, AliasOwnershipConflict,
)
from linuxmusterTools.devices.devices import Devices

def main():
    # Argparse help text is user-facing -> in English
    parser = argparse.ArgumentParser(
        description="Updates OPNsense aliases for a given school."
    )
    parser.add_argument(
        "--school",
        help="Name of the school config to use",
        default="default-school"
    )
    parser.add_argument(
        "--quiet",
        help="Suppress all normal output except errors",
        action="store_true"
    )

    args = parser.parse_args()

    try:
        # Initialize API and read configuration
        api = LinuxmusterOPNsenseAPI(school_name=args.school)
        school_conf = api.school_config

        # Retrieve devices from the linuxmusterTools library
        dev = Devices(school=school_conf.school_name_conf)
        all_devices = dev.filter()

        # Counters to keep track of how many aliases we update
        updated_aliases_count = 0

        # Data structures for reporting
        updated_roles = []
        updated_rooms = []
        updated_hwgroups = []
        skipped = []

        def sync_alias(kind, alias_name, ips, bucket):
            """Create/update one alias for this school. On an ownership conflict
            (the alias already belongs to another school) record it and keep
            going instead of aborting the whole run."""
            try:
                api.create_or_update_alias(
                    alias_name, ips,
                    school=school_conf.school_name_conf, kind=kind, apply=False,
                )
                bucket.append(alias_name)
                return True
            except AliasOwnershipConflict as exc:
                print(f"WARNING: {exc}", file=sys.stderr)
                skipped.append(alias_name)
                return False

        # ----- Roles Aliases -----
        # Check if role synchronization is enabled
        if school_conf.sync_roles:
            roles = set(d.get('sophomorixRole') for d in all_devices if 'sophomorixRole' in d)
            for role in roles:
                if role:
                    alias_name = sanitize_alias_name(
                        f"{school_conf.school_prefix}{school_conf.roles_prefix}{role}")
                    ips = [x['ip'] for x in all_devices if x.get('sophomorixRole') == role and x.get('ip')]
                    if ips and sync_alias('role', alias_name, ips, updated_roles):
                        updated_aliases_count += 1

        # ----- Rooms Aliases -----
        if school_conf.sync_rooms:
            rooms = set(d.get('room') for d in all_devices if 'room' in d)
            for room in rooms:
                if room:
                    alias_name = sanitize_alias_name(
                        f"{school_conf.school_prefix}{school_conf.rooms_prefix}{room}")
                    ips = [x['ip'] for x in all_devices if x.get('room') == room and x.get('ip')]
                    if ips and sync_alias('room', alias_name, ips, updated_rooms):
                        updated_aliases_count += 1

        # ----- Hardware Groups Aliases -----
        if school_conf.sync_hwgroups:
            hwgroups = set(d.get('group') for d in all_devices if 'group' in d)
            for hwg in hwgroups:
                if hwg:
                    alias_name = sanitize_alias_name(
                        f"{school_conf.school_prefix}{school_conf.hwgroups_prefix}{hwg}")
                    ips = [x['ip'] for x in all_devices if x.get('group') == hwg and x.get('ip')]
                    if ips and sync_alias('hwgroup', alias_name, ips, updated_hwgroups):
                        updated_aliases_count += 1

        # Apply all alias changes with a single reconfigure instead of
        # reconfiguring the firewall after every individual alias.
        if updated_aliases_count > 0:
            api.apply_alias_changes()

        # ----- Output -----
        if not args.quiet:
            print("")
            print(f"######## OPNsense Alias Update Report for '{args.school}' ########")
            print("")

            print(f"Roles synchronization: {'enabled' if school_conf.sync_roles else 'disabled'}")
            print(f"Rooms synchronization: {'enabled' if school_conf.sync_rooms else 'disabled'}")
            print(f"Hardware groups synchronization: {'enabled' if school_conf.sync_hwgroups else 'disabled'}")
            print("")

            if updated_roles:
                print("Updated Role Aliases:")
                for role_alias in updated_roles:
                    print(f"  - {role_alias}")
            if updated_rooms:
                print("\nUpdated Room Aliases:")
                for room_alias in updated_rooms:
                    print(f"  - {room_alias}")
            if updated_hwgroups:
                print("\nUpdated Hardware Group Aliases:")
                for hwg_alias in updated_hwgroups:
                    print(f"  - {hwg_alias}")

            print("")
            print(f"Total updated aliases: {updated_aliases_count}")
            if skipped:
                print(f"Skipped (ownership conflict): {len(skipped)}")
            else:
                print(f"All configured aliases have been successfully updated for '{args.school}'.")
            print("")

        # Signal partial failure (exit != 0) so opn-update-all-schools flags this
        # school while still syncing the others. Runs even in --quiet mode.
        if skipped:
            print(
                f"WARNING: {len(skipped)} alias(es) skipped because another school "
                f"owns them: {', '.join(skipped)}",
                file=sys.stderr,
            )
            sys.exit(1)

    except Exception as e:
        # Always print errors
        print(f"Error updating aliases: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
