#!/usr/bin/env python3
import os
import sys
import subprocess

# This script iterates over all *.ini files in /etc/linuxmuster/opnsense and updates the aliases
# for each school by calling /usr/sbin/opn-update-aliases.
def main():
    config_path = "/etc/linuxmuster/opnsense"

    if not os.path.isdir(config_path):
        print(f"Error: Directory '{config_path}' does not exist.", file=sys.stderr)
        sys.exit(1)

    ini_files = [
        f for f in os.listdir(config_path)
        if f.endswith('.ini') and not f.endswith('.ini.default')
    ]

    if not ini_files:
        print("No valid .ini files found. Nothing to update.")
        sys.exit(0)

    failed_schools = []
    for ini_file in ini_files:
        school_name = ini_file[:-4]  # remove .ini
        print(f"Updating aliases for school: {school_name}")
        cmd = ["/usr/sbin/opn-update-aliases", "--school", school_name]

        # Uncomment the following line to run in quiet mode:
        # cmd.append("--quiet")

        try:
            subprocess.run(cmd, check=True)
        except subprocess.CalledProcessError as e:
            # Do not abort the whole hook just because one school failed;
            # keep going so the remaining schools still get updated.
            print(f"Error updating aliases for '{school_name}': {e}", file=sys.stderr)
            failed_schools.append(school_name)

    if failed_schools:
        print(
            f"Finished with errors. Failed schools: {', '.join(failed_schools)}",
            file=sys.stderr,
        )
        sys.exit(1)

    print("All schools have been successfully updated.")

if __name__ == "__main__":
    main()
