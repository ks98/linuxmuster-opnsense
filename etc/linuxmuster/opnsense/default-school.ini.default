[opnsense]
api_key =
api_secret =
base_url = https://firewall.linuxmuster.lan/api
verify_ssl = True
ca_bundle =

[school]
name = default-school

[aliases]
# Prepended to every alias name of this school. Leave empty for a single
# school. When syncing several schools onto ONE firewall, give each school a
# distinct, short value (e.g. S1_, S2_) so their aliases do not collide.
school_prefix =
sync_roles = True
roles_prefix = ROLE_
sync_rooms = True
rooms_prefix = ROOM_
sync_hwgroups = True
hwgroups_prefix = HWGROUP_

[wlan]
kill_session = True

[voucher]
provider = Voucher
